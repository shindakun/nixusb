// niri config. Installed to ~/.config/niri/config.kdl by install/dotfiles.sh.
//
// Keybinds mirror the Hyprland setup in nix/home/steve.nix so muscle memory
// carries over. The one real difference is the window model: niri is
// SCROLLABLE tiling, so windows live on an infinite horizontal strip per
// workspace instead of being split into a tree. Super+Left/Right move along
// that strip; Super+Up/Down move between stacked windows in a column.

input {
    keyboard {
        xkb {
            layout "us"
        }
    }

    touchpad {
        tap
        natural-scroll
        dwt                     // disable-while-typing
        accel-profile "adaptive"
    }

    mouse {
        accel-profile "flat"
    }

    // Focus follows the mouse only when it actually moves onto a window.
    warp-mouse-to-focus
}

// Autodetect the display. Override per machine by uncommenting and editing:
//   output "eDP-1"  { scale 1.0  mode "1440x900@60" }        // MacBook Air
//   output "DP-1"   { scale 1.0  mode "1920x1080@60" }       // XPS monitor
output "eDP-1" {
    scale 1.0
}

layout {
    gaps 10
    center-focused-column "never"

    // Column widths cycled by Super+R.
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    default-column-width { proportion 0.5; }

    focus-ring {
        width 2
        active-color "#7aa2f7"
        inactive-color "#3b4261"
    }
}

// ---- startup ----------------------------------------------------------
// xwayland-satellite is what makes X11 apps work; niri has no built-in
// XWayland (this is the main practical difference from Hyprland).
spawn-at-startup "xwayland-satellite"
spawn-at-startup "waybar"
spawn-at-startup "mako"
spawn-at-startup "swaybg" "-i" "/usr/share/backgrounds/archlinux/simple.png" "-m" "fill"
// Clipboard history (Wayland has no clipboard daemon by default).
spawn-at-startup "sh" "-c" "wl-paste --type text --watch cliphist store"
spawn-at-startup "sh" "-c" "wl-paste --type image --watch cliphist store"
spawn-at-startup "/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1"

// Tell XWayland-hosted apps which display to use.
environment {
    DISPLAY ":0"
    NIXOS_OZONE_WL "1"          // harmless here; Electron/Chromium Wayland hint
    ELECTRON_OZONE_PLATFORM_HINT "auto"
    MOZ_ENABLE_WAYLAND "1"
}

prefer-no-csd
screenshot-path "~/Pictures/Screenshots/screenshot-%Y-%m-%d-%H-%M-%S.png"

// ---- keybinds ---------------------------------------------------------
binds {
    Mod+Shift+Slash { show-hotkey-overlay; }

    // Launchers (same as Hyprland: Return = terminal, D = launcher).
    Mod+Return { spawn "kitty"; }
    Mod+D      { spawn "fuzzel"; }
    Mod+E      { spawn "nautilus"; }

    // Window management.
    Mod+Q            { close-window; }
    Mod+V            { toggle-window-floating; }
    Mod+F            { maximize-column; }
    Mod+Shift+F      { fullscreen-window; }
    Mod+Shift+M      { quit; }

    // Focus. Left/Right walk the scrollable strip; Up/Down walk a column.
    Mod+Left   { focus-column-left; }
    Mod+Right  { focus-column-right; }
    Mod+Up     { focus-window-up; }
    Mod+Down   { focus-window-down; }
    Mod+H      { focus-column-left; }
    Mod+L      { focus-column-right; }
    Mod+K      { focus-window-up; }
    Mod+J      { focus-window-down; }

    // Move windows.
    Mod+Shift+Left   { move-column-left; }
    Mod+Shift+Right  { move-column-right; }
    Mod+Shift+Up     { move-window-up; }
    Mod+Shift+Down   { move-window-down; }

    // Column sizing.
    Mod+R            { switch-preset-column-width; }
    Mod+Minus        { set-column-width "-10%"; }
    Mod+Equal        { set-column-width "+10%"; }
    Mod+Comma        { consume-window-into-column; }
    Mod+Period       { expel-window-from-column; }

    // Workspaces 1-4, matching the Hyprland binds.
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }

    // Screenshots. Print = region picker (matches the Hyprland grim/slurp bind).
    Print            { screenshot; }
    Ctrl+Print       { screenshot-screen; }
    Alt+Print        { screenshot-window; }

    // Media / brightness keys.
    XF86AudioRaiseVolume  allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%+"; }
    XF86AudioLowerVolume  allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-"; }
    XF86AudioMute         allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    XF86AudioPlay         allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86MonBrightnessUp   allow-when-locked=true { spawn "brightnessctl" "set" "5%+"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "set" "5%-"; }

    // Lock.
    Super+Alt+L { spawn "swaylock" "-f" "-c" "1a1b26"; }
}
